+void GRenderWindow::RecordFrames(const QString& folder, int count) {
+    const u32 height = Settings::IsDockedMode() ? Layout::ScreenDocked::Height
+                                                : Layout::ScreenUndocked::Height;
+    const u32 width = UISettings::CalculateWidth(height, Settings::values.aspect_ratio.GetValue());
+    recording_folder = folder;
+    recording_layout = Layout::DefaultFrameLayout(width, height);
+    recording_index = 0;
+    recording_left = count;
+    RecordNextFrame();
+}
+
+void GRenderWindow::RecordNextFrame() {
+    auto& renderer = system.Renderer();
+    while (renderer.IsScreenshotPending()) {
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+    auto image = std::make_shared<QImage>(QSize(recording_layout.width, recording_layout.height),
+                                          QImage::Format_RGB32);
+    renderer.RequestScreenshot(
+        image->bits(),
+        [this, image](bool invert_y) {
+            const int index = recording_index.fetch_add(1);
+            if (recording_left.fetch_sub(1) > 1) {
+                RecordNextFrame();
+            }
+            image->mirrored(false, invert_y)
+                .save(QStringLiteral("%1/frame-%2.png").arg(recording_folder).arg(index, 4, 10, QLatin1Char('0')));
+        },
+        recording_layout);
+}
+
 bool GRenderWindow::IsLoadingComplete() const {
     return first_frame;
 }
