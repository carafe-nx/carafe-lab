@@ -269,10 +263,22 @@ void TranslatorVisitor::SUST(u64 insn) {
         color = MakeColor(ir, sust.data_reg, SizeInRegs(sust.size));
     } else {
         const unsigned mask{SwizzleMask(sust.swizzle)};
-        if (mask != 0xf) {
