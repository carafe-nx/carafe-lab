+void KProcess::PatchRuntimeCode(KProcessAddress address, size_t size) {
+    constexpr u32 NroMagic = 0x304F524E;
+    constexpr size_t NroMagicOffset = 0x10;
+    constexpr size_t NroHeaderEnd = 0x80;
+    constexpr size_t PatcherSkippedBytes = 0x24;
+    constexpr size_t MaxRelativeBranch = 128ULL << 20;
+
+    if (!this->IsApplication() || !Settings::IsNceEnabled() || size <= NroHeaderEnd) {
+        return;
+    }
+    const u64 module_start = GetInteger(address);
+    if (m_memory.Read32(module_start + NroMagicOffset) != NroMagic) {
+        return;
+    }
+    for (const auto& known : m_runtime_patches) {
+        if (module_start < known.code_end && known.code_start < module_start + size) {
+            return;
+        }
+    }
+
+    const u64 text_start = module_start + NroHeaderEnd - PatcherSkippedBytes;
+    const size_t text_size = size - (NroHeaderEnd - PatcherSkippedBytes);
+    std::vector<u8> image(text_size);
+    m_memory.ReadBlock(text_start, image.data(), text_size);
+
+    Core::NCE::Patcher patcher;
+    const CodeSet::Segment text{.offset = 0, .addr = 0, .size = static_cast<u32>(text_size)};
+    if (!patcher.PatchText(image, text) ||
+        patcher.GetPatchMode() != Core::NCE::PatchMode::PostData) {
+        LOG_ERROR(Kernel, "NCE: code at {:#x} ({:#x} bytes) is too large to patch", module_start,
+                  size);
+        return;
+    }
+    const size_t patch_size = patcher.GetSectionSize();
+
+    KProcessAddress patch_address = 0;
+    u64 candidate = Common::AlignUp(text_start + text_size, PageSize);
+    while (candidate + patch_size - text_start <= MaxRelativeBranch) {
+        KMemoryInfo info;
+        Svc::PageInfo page_info;
+        if (R_FAILED(m_page_table.QueryInfo(&info, &page_info, candidate))) {
+            break;
+        }
+        const bool fits = info.GetState() == KMemoryState::Free &&
+                          candidate + patch_size <= info.GetEndAddress() &&
+                          m_page_table.CanContain(candidate, patch_size, KMemoryState::AliasCode);
+        if (fits) {
+            patch_address = candidate;
+            break;
+        }
+        candidate = info.GetEndAddress();
+    }
+    if (patch_address == 0 ||
+        R_FAILED(m_page_table.MapPages(patch_address, patch_size / PageSize,
+                                       KMemoryState::AliasCode,
+                                       KMemoryPermission::UserReadWrite))) {
+        LOG_ERROR(Kernel, "NCE: no room for the patch of the code at {:#x}", module_start);
+        return;
+    }
+
+    Core::NCE::EntryTrampolines trampolines;
+    patcher.SetPatchSectionDistance(GetInteger(patch_address) - text_start);
+    patcher.RelocateAndCopy(text_start, text, image, &trampolines);
+    m_memory.WriteBlock(text_start, image.data(), text_size);
+    m_memory.WriteBlock(patch_address, image.data() + text_size, patch_size);
+
+    auto* const text_pointer = reinterpret_cast<char*>(text_start);
+    auto* const patch_pointer = reinterpret_cast<char*>(GetInteger(patch_address));
+    __builtin___clear_cache(text_pointer, text_pointer + text_size);
+    __builtin___clear_cache(patch_pointer, patch_pointer + patch_size);
+
+    m_page_table.SetProcessMemoryPermission(patch_address, patch_size,
+                                            Svc::MemoryPermission::None);
+    m_kernel.System().DeviceMemory().buffer.Protect(
+        GetInteger(patch_address), patch_size,
+        Common::MemoryPermission::Read | Common::MemoryPermission::Execute);
+
+    {
+        std::unique_lock lk{m_post_handlers_lock};
+        m_post_handlers.insert(trampolines.begin(), trampolines.end());
+    }
+    m_runtime_patches.push_back({module_start, module_start + size, patch_address, patch_size});
+    LOG_INFO(Kernel, "NCE: patched code at {:#x} ({:#x} bytes), {} entries, patch at {:#x}",
+             module_start, size, trampolines.size(), GetInteger(patch_address));
+}
+
+void KProcess::ForgetRuntimeCode(KProcessAddress address, size_t size) {
+    const u64 start = GetInteger(address);
+    const u64 end = start + size;
+    for (auto it = m_runtime_patches.begin(); it != m_runtime_patches.end();) {
+        if (it->code_start < start || end < it->code_end) {
+            ++it;
+            continue;
+        }
+        {
+            std::unique_lock lk{m_post_handlers_lock};
+            std::vector<u64> stale;
+            for (const auto& [pc, trampoline] : m_post_handlers) {
+                if (it->code_start <= pc && pc <= it->code_end) {
+                    stale.push_back(pc);
+                }
+            }
+            for (const u64 pc : stale) {
+                m_post_handlers.erase(pc);
+            }
+        }
+        m_page_table.UnmapPages(it->patch_address, it->patch_size / PageSize,
+                                KMemoryState::AliasCode);
+        it = m_runtime_patches.erase(it);
+    }
+}
