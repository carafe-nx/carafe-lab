 // Video Core //
@@ -1971,6 +1973,38 @@ void MainWindow::OnControlTick() {
         }
         render_window->CaptureScreenshot(argument);
         ControlReply(QStringLiteral("capturing %1").arg(argument));
+    } else if (verb == QStringLiteral("press")) {
+        const QStringList words = argument.split(QLatin1Char(' '), Qt::SkipEmptyParts);
+        bool hold_read = false;
+        const int hold = words.isEmpty() ? 0 : words.first().toInt(&hold_read);
+        if (!emulation_running) {
+            ControlReply(QStringLiteral("error idle"));
+            return;
+        }
+        if (!hold_read || hold <= 0 || words.size() < 2) {
+            ControlReply(QStringLiteral("error press %1").arg(argument));
+            return;
+        }
+        QList<int> keys;
+        for (const QString& name : words.mid(1)) {
+            const QKeySequence sequence =
+                QKeySequence::fromString(name.size() == 1 ? name.toUpper() : name);
+            if (sequence.isEmpty()) {
+                ControlReply(QStringLiteral("error key %1").arg(name));
+                return;
+            }
+            keys.append(static_cast<int>(sequence[0].key()));
+        }
+        for (const int key : keys) {
+            input_subsystem->GetKeyboard()->PressKey(key);
+        }
+        ControlReply(QStringLiteral("pressed %1").arg(words.mid(1).join(QLatin1Char(' '))));
+        QTimer::singleShot(hold, this, [this, keys] {
+            for (const int key : keys) {
+                input_subsystem->GetKeyboard()->ReleaseKey(key);
+            }
+            ControlReply(QStringLiteral("released"));
+        });
     } else {
         ControlReply(QStringLiteral("error unknown %1").arg(verb));
     }
