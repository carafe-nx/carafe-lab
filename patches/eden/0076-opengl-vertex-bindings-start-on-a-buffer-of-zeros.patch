+void BufferCacheRuntime::BindZeroVertexBuffers() {
+    if (zero_vertex_buffers_bound || has_unified_vertex_buffers) {
+        return;
+    }
+    zero_vertex_buffers_bound = true;
+    static constexpr GLsizeiptr ZERO_VERTEX_BUFFER_SIZE = 0x8000;
+    const std::vector<u8> zeros(ZERO_VERTEX_BUFFER_SIZE);
+    zero_vertex_buffer.Create();
+    glNamedBufferStorage(zero_vertex_buffer.handle, ZERO_VERTEX_BUFFER_SIZE, zeros.data(), 0);
+    for (u32 index = 0; index < (std::min)(max_attributes, 32U); ++index) {
+        glBindVertexBuffer(index, zero_vertex_buffer.handle, 0, 0);
+    }
+}
+
 void BufferCacheRuntime::BindVertexBuffer(u32 index, Buffer& buffer, u32 offset, u32 size,
                                           u32 stride) {
     if (index >= max_attributes) {
         return;
     }
+    BindZeroVertexBuffers();
     if (has_unified_vertex_buffers) {
         buffer.MakeResident(GL_READ_ONLY);
         glBindVertexBuffer(index, 0, 0, static_cast<GLsizei>(stride));
