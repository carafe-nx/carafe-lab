+++ b/src/video_core/renderer_opengl/gl_memory_budget.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <charconv>
+#include <cstdint>
+#include <string_view>
+
+namespace OpenGL::MemoryAccounting {
+constexpr std::uint64_t DefaultBudget = 4096ull * 1024 * 1024;
+inline std::uint64_t ReadBudget(const char* text) {
+    if (!text) return DefaultBudget;
+    const std::string_view value{text};
+    std::uint64_t mib = 0;
+    const auto parsed = std::from_chars(value.data(), value.data() + value.size(), mib);
+    if (parsed.ec != std::errc{} || parsed.ptr != value.data() + value.size() || mib < 512 || mib > 8192)
+        return DefaultBudget;
+    return mib * 1024 * 1024;
+}
+constexpr std::uint64_t UsageSince(std::uint64_t baseline, std::uint64_t available) {
+    return baseline > available ? baseline - available : 0;
+}
+}
