@@ -0,0 +1,38 @@
+#pragma once
+#include <cstddef>
+#include <utility>
+
+namespace OpenGL::MemoryAccounting {
+class StagingLease {
+public:
+    StagingLease() = default;
+    explicit StagingLease(std::size_t& count) : borrowers{&count} { ++*borrowers; }
+    StagingLease(const StagingLease& other) : borrowers{other.borrowers} {
+        if (borrowers) ++*borrowers;
+    }
+    StagingLease(StagingLease&& other) noexcept : borrowers{std::exchange(other.borrowers, nullptr)} {}
+    StagingLease& operator=(const StagingLease& other) {
+        if (this != &other) {
+            Release();
+            borrowers = other.borrowers;
+            if (borrowers) ++*borrowers;
+        }
+        return *this;
+    }
+    StagingLease& operator=(StagingLease&& other) noexcept {
+        if (this != &other) {
+            Release();
+            borrowers = std::exchange(other.borrowers, nullptr);
+        }
+        return *this;
+    }
+    ~StagingLease() { Release(); }
+    bool IsLast() const { return borrowers && *borrowers == 1; }
+private:
+    void Release() {
+        if (borrowers) --*borrowers;
+        borrowers = nullptr;
+    }
+    std::size_t* borrowers = nullptr;
+};
+}
