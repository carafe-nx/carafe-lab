@@ -356,8 +356,10 @@ void EmitIR<IR::Opcode::A64SetFPCR>(oaknut::CodeGenerator& code, EmitContext& ct
     auto args = ctx.reg_alloc.GetArgumentInfo(inst);
     auto Wvalue = ctx.reg_alloc.ReadW(args[0]);
