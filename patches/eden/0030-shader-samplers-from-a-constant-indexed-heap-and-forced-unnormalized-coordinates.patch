+std::optional<IndirectHandle> TrackIndirectHandle(const IR::Value& value) {
+    if (value.IsImmediate()) {
+        return std::nullopt;
+    }
+    const IR::Inst* inst{value.InstRecursive()};
+    if (inst->GetOpcode() == IR::Opcode::BitwiseAnd32) {
+        const auto split{SplitImmediate(inst)};
+        if (!split) {
+            return std::nullopt;
+        }
+        inst = split->first;
+    }
+    if (inst->GetOpcode() != IR::Opcode::GetCbufU32 || !inst->Arg(0).IsImmediate() ||
+        inst->Arg(1).IsImmediate()) {
+        return std::nullopt;
+    }
+    IndirectHandle result{
+        .index = inst->Arg(0).U32(),
+        .offset = 0,
+        .dynamic_index = 0,
+        .dynamic_offset = 0,
+        .bit_offset = 0,
+        .bit_count = 32,
+        .max = 0xffffffffU,
+        .shift = 0,
+    };
+    const IR::Inst* dynamic{inst->Arg(1).InstRecursive()};
+    if (dynamic->GetOpcode() == IR::Opcode::IAdd32) {
+        const auto split{SplitImmediate(dynamic)};
+        if (!split) {
+            return std::nullopt;
+        }
+        result.offset = split->second;
+        dynamic = split->first;
+    }
+    if (dynamic->GetOpcode() == IR::Opcode::ShiftLeftLogical32) {
+        if (dynamic->Arg(0).IsImmediate() || !dynamic->Arg(1).IsImmediate()) {
+            return std::nullopt;
+        }
+        result.shift = dynamic->Arg(1).U32();
+        dynamic = dynamic->Arg(0).InstRecursive();
+    }
+    if (dynamic->GetOpcode() == IR::Opcode::UMin32) {
+        const auto split{SplitImmediate(dynamic)};
+        if (!split) {
+            return std::nullopt;
+        }
+        result.max = split->second;
+        dynamic = split->first;
+    }
+    if (dynamic->GetOpcode() == IR::Opcode::BitwiseAnd32) {
+        const auto split{SplitImmediate(dynamic)};
+        if (!split || (split->second & (split->second + 1)) != 0) {
+            return std::nullopt;
+        }
+        result.bit_count = static_cast<u32>(std::popcount(split->second));
+        dynamic = split->first;
+    }
+    switch (dynamic->GetOpcode()) {
+    case IR::Opcode::BitFieldUExtract:
+        if (dynamic->Arg(0).IsImmediate() || !dynamic->Arg(1).IsImmediate() ||
+            !dynamic->Arg(2).IsImmediate()) {
+            return std::nullopt;
+        }
+        result.bit_offset = dynamic->Arg(1).U32();
+        result.bit_count = (std::min)(result.bit_count, dynamic->Arg(2).U32());
+        dynamic = dynamic->Arg(0).InstRecursive();
+        break;
+    case IR::Opcode::ShiftRightLogical32:
+        if (dynamic->Arg(0).IsImmediate() || !dynamic->Arg(1).IsImmediate()) {
+            return std::nullopt;
+        }
+        result.bit_offset = dynamic->Arg(1).U32();
+        dynamic = dynamic->Arg(0).InstRecursive();
+        break;
+    default:
+        break;
+    }
+    if (!dynamic->Arg(0).IsImmediate() || !dynamic->Arg(1).IsImmediate()) {
+        return std::nullopt;
+    }
+    const u32 dynamic_offset{dynamic->Arg(1).U32()};
+    switch (dynamic->GetOpcode()) {
+    case IR::Opcode::GetCbufU32:
+        break;
+    case IR::Opcode::GetCbufU16:
+        result.bit_offset += (dynamic_offset & 3) * 8;
+        result.bit_count = (std::min)(result.bit_count, 16U);
