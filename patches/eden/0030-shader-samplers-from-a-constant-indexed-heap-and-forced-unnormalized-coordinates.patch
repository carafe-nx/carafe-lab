+    const IR::Value lhs{inst->Arg(0)};
+    const IR::Value rhs{inst->Arg(1)};
+    if (rhs.IsImmediate() && !lhs.IsImmediate()) {
+        return std::pair{lhs.InstRecursive(), rhs.U32()};
+    }
+    if (lhs.IsImmediate() && !rhs.IsImmediate()) {
