+        result.bit_count = (std::min)(result.bit_count, 8U);
+        break;
+    default:
+        return std::nullopt;
+    }
+    if (result.bit_offset >= 32) {
+        return std::nullopt;
+    }
+    result.dynamic_index = dynamic->Arg(0).U32();
+    result.dynamic_offset = dynamic_offset & ~3U;
+    return result;
+}
