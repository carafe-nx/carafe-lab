diff --git a/src/shader_recompiler/frontend/maxwell/translate/impl/byte_permute.cpp b/src/shader_recompiler/frontend/maxwell/translate/impl/byte_permute.cpp
new file mode 100644
index 0000000..deeaecb
--- /dev/null
+++ b/src/shader_recompiler/frontend/maxwell/translate/impl/byte_permute.cpp
@@ -0,0 +1,113 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <optional>
+
+#include "common/bit_field.h"
+#include "common/common_types.h"
+#include "shader_recompiler/frontend/maxwell/translate/impl/impl.h"
+
+namespace Shader::Maxwell {
+namespace {
+enum class Mode : u64 {
+    Index = 0,
+    Forward4Extract = 1,
+    Backward4Extract = 2,
+    Replicate8 = 3,
+    EdgeClampLeft = 4,
+    EdgeClampRight = 5,
+    Replicate16 = 6,
+};
+
+u32 TableIndex(Mode mode, u32 n, u32 byte) {
+    switch (mode) {
+    case Mode::Forward4Extract:
+        return (n + byte) & 7;
+    case Mode::Backward4Extract:
+        return (n - byte) & 7;
+    case Mode::Replicate8:
+        return n;
+    case Mode::EdgeClampLeft:
+        return std::max(byte, n);
+    case Mode::EdgeClampRight:
+        return std::min(byte, n);
+    case Mode::Replicate16:
+        return (byte & 1) + 2 * (n & 1);
+    default:
+        throw NotImplementedException("PRMT mode {}", static_cast<u64>(mode));
+    }
+}
+
+IR::U32 PickByte(TranslatorVisitor& v, const IR::U32& a, const IR::U32& b, const IR::U32& index,
+                 const IR::U1& replicate_sign) {
+    const IR::U1 from_b{v.ir.INotEqual(v.ir.BitwiseAnd(index, v.ir.Imm32(4)), v.ir.Imm32(0))};
+    const IR::U32 word{v.ir.Select(from_b, b, a)};
+    const IR::U32 offset{v.ir.ShiftLeftLogical(v.ir.BitwiseAnd(index, v.ir.Imm32(3)), v.ir.Imm32(3))};
+    const IR::U32 value{v.ir.BitFieldExtract(word, offset, v.ir.Imm32(8), false)};
+    const IR::U32 sign{v.ir.BitFieldExtract(word, v.ir.IAdd(offset, v.ir.Imm32(7)), v.ir.Imm32(1), true)};
+    return IR::U32{v.ir.Select(replicate_sign, v.ir.BitwiseAnd(sign, v.ir.Imm32(0xff)), value)};
+}
+
+void PRMT(TranslatorVisitor& v, u64 insn, const IR::U32& selector, const IR::U32& src_b) {
+    union {
+        u64 raw;
+        BitField<0, 8, IR::Reg> dest_reg;
+        BitField<8, 8, IR::Reg> src_reg_a;
+        BitField<48, 3, Mode> mode;
+    } const prmt{insn};
+
+    const IR::U32 src_a{v.X(prmt.src_reg_a)};
+    const Mode mode{prmt.mode};
+    const std::optional<u32> imm{selector.IsImmediate() ? std::optional{selector.U32()}
+                                                        : std::nullopt};
+    IR::U32 result{v.ir.Imm32(0)};
+    for (u32 byte = 0; byte < 4; ++byte) {
+        IR::U32 index;
+        IR::U1 replicate_sign{v.ir.Imm1(false)};
+        if (mode == Mode::Index) {
+            if (imm) {
+                const u32 nibble{(*imm >> (byte * 4)) & 0xf};
+                index = v.ir.Imm32(nibble & 7);
+                replicate_sign = v.ir.Imm1((nibble & 8) != 0);
+            } else {
+                const IR::U32 nibble{
+                    v.ir.BitFieldExtract(selector, v.ir.Imm32(byte * 4), v.ir.Imm32(4), false)};
+                index = v.ir.BitwiseAnd(nibble, v.ir.Imm32(7));
+                replicate_sign =
+                    v.ir.INotEqual(v.ir.BitwiseAnd(nibble, v.ir.Imm32(8)), v.ir.Imm32(0));
+            }
+        } else if (imm) {
+            index = v.ir.Imm32(TableIndex(mode, *imm & 3, byte));
+        } else {
+            const IR::U32 n{v.ir.BitwiseAnd(selector, v.ir.Imm32(3))};
+            index = v.ir.Imm32(TableIndex(mode, 3, byte));
+            for (u32 i = 0; i < 3; ++i) {
+                index = IR::U32{v.ir.Select(v.ir.IEqual(n, v.ir.Imm32(i)),
+                                            v.ir.Imm32(TableIndex(mode, i, byte)), index)};
+            }
+        }
+        const IR::U32 picked{PickByte(v, src_a, src_b, index, replicate_sign)};
+        result = v.ir.BitFieldInsert(result, picked, v.ir.Imm32(byte * 8), v.ir.Imm32(8));
+    }
+    v.X(prmt.dest_reg, result);
+}
+}
+
+void TranslatorVisitor::PRMT_reg(u64 insn) {
+    PRMT(*this, insn, GetReg20(insn), GetReg39(insn));
+}
+
+void TranslatorVisitor::PRMT_rc(u64 insn) {
+    PRMT(*this, insn, GetReg39(insn), GetCbuf(insn));
+}
+
+void TranslatorVisitor::PRMT_cr(u64 insn) {
+    PRMT(*this, insn, GetCbuf(insn), GetReg39(insn));
+}
+
+void TranslatorVisitor::PRMT_imm(u64 insn) {
+    PRMT(*this, insn, GetImm20(insn), GetReg39(insn));
+}
+
+}
