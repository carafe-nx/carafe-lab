+bool ArmNce::HandleGuestTrap(GuestContext* guest_ctx, void* raw_info, void* raw_context) {
+    auto* info = static_cast<siginfo_t*>(raw_info);
+    auto& host_ctx = static_cast<ucontext_t*>(raw_context)->uc_mcontext;
+    auto& thread_params = guest_ctx->parent->m_running_thread->GetNativeExecutionParameters();
+
+    if (info->si_signo == SIGILL) {
+        auto* const instruction = reinterpret_cast<u32*>(host_ctx.pc);
+        const u32 opcode = *instruction & ~MrsRegisterMask;
+        if (opcode == MrsCntvctEl0) {
+            return true;
+        }
+        if (opcode == MrsCntpctEl0) {
+            auto& memory = guest_ctx->parent->m_running_thread->GetOwnerProcess()->GetMemory();
+            memory.Write32(host_ctx.pc, MrsCntvctEl0 | (*instruction & MrsRegisterMask));
+            auto* const start = reinterpret_cast<char*>(instruction);
+            __builtin___clear_cache(start, start + sizeof(u32));
+            return true;
+        }
+    }
+
+    guest_ctx->esr_el1.fetch_or(static_cast<u64>(HaltReason::InstructionBreakpoint));
+    thread_params.lock.store(SpinLockLocked);
+    SaveGuestContext(guest_ctx, raw_context);
+    return false;
+}
+
+void ArmNce::HandleHostTrap(int sig, void* raw_info, void* raw_context) {
+    const auto& original = sig == SIGILL ? g_orig_ill_action : g_orig_trap_action;
+    if ((original.sa_flags & SA_SIGINFO) != 0 && original.sa_sigaction != nullptr) {
+        return original.sa_sigaction(sig, static_cast<siginfo_t*>(raw_info), raw_context);
+    }
+    if (original.sa_handler != SIG_DFL && original.sa_handler != SIG_IGN) {
+        return original.sa_handler(sig);
+    }
+    signal(sig, SIG_DFL);
+}
