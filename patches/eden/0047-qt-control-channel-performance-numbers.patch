Carafe Lab: with the control channel on, Eden appends its performance numbers to `stats` in the control folder every
time it updates its status bar (twice a second while software runs): the time in Unix milliseconds, the game's
average FPS, the emulation speed (1.0 is full speed), the frame time in milliseconds and the shaders building.
GPL-3.0-or-later, as the files it changes.

diff --git a/src/yuzu/main_window.cpp b/src/yuzu/main_window.cpp
index 55ff4b9..ea6f443 100644
--- a/src/yuzu/main_window.cpp
+++ b/src/yuzu/main_window.cpp
@@ -4445,6 +4445,21 @@ void MainWindow::UpdateStatusBar() {
 
     emit statsUpdated(results, shader_notify);
 
+#ifdef __unix__
+    if (!control_dir.isEmpty()) {
+        QFile stats(control_dir + QStringLiteral("/stats"));
+        if (stats.open(QIODevice::Append | QIODevice::Text)) {
+            stats.write(QStringLiteral("%1 %2 %3 %4 %5\n")
+                            .arg(QDateTime::currentMSecsSinceEpoch())
+                            .arg(results.average_game_fps, 0, 'f', 2)
+                            .arg(results.emulation_speed, 0, 'f', 3)
+                            .arg(results.frametime * 1000.0, 0, 'f', 2)
+                            .arg(shaders_building)
+                            .toUtf8());
+        }
+    }
+#endif
+
     if (shaders_building > 0) {
         shader_building_label->setText(tr("Building: %n shader(s)", "", shaders_building));
         shader_building_label->setVisible(true);
