--- /dev/null
+++ b/src/video_core/gpu_timing.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <string>
+
+#include <fmt/format.h>
+
+#include "common/common_types.h"
+
+namespace VideoCommon::GpuTiming {
+
+enum class Counter : std::size_t {
+    Idle,
+    Submit,
+    Flush,
+    Composite,
+    Swap,
+    CompositeWait,
+    CpuRead,
+    FenceWait,
+    NceGpuRead,
+    NceGpuWrite,
+    NceGuestFault,
+    NceTrap,
+    Count,
+};
+
+struct Entry {
+    std::atomic<u64> count{};
+    std::atomic<u64> nanoseconds{};
+};
+
+inline std::array<Entry, static_cast<std::size_t>(Counter::Count)> entries{};
+
+inline u64 Now() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+inline void Add(Counter counter, u64 nanoseconds) {
+    auto& entry = entries[static_cast<std::size_t>(counter)];
+    entry.count.fetch_add(1, std::memory_order_relaxed);
+    entry.nanoseconds.fetch_add(nanoseconds, std::memory_order_relaxed);
+}
+
+class Scope {
+public:
+    explicit Scope(Counter counter_) : counter{counter_}, start{Now()} {}
+    ~Scope() {
+        Add(counter, Now() - start);
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    Counter counter;
+    u64 start;
+};
+
+inline std::string TakeReport(double seconds) {
+    std::array<u64, static_cast<std::size_t>(Counter::Count)> count{};
+    std::array<u64, static_cast<std::size_t>(Counter::Count)> milliseconds{};
+    for (std::size_t i = 0; i < entries.size(); ++i) {
+        count[i] = entries[i].count.exchange(0, std::memory_order_relaxed);
+        milliseconds[i] = entries[i].nanoseconds.exchange(0, std::memory_order_relaxed) / 1'000'000;
+    }
+    const auto at = [](Counter counter) { return static_cast<std::size_t>(counter); };
+    return fmt::format(
+        "[GPU timing] {:.1f} s: idle {} ms; submits {} ({} ms); flushes {} ({} ms); "
+        "composites {} ({} ms, swap {} ms); composite waits {} ({} ms); cpu reads {} ({} ms); "
+        "fence waits {} ({} ms); nce gpu reads {} ({} ms), gpu writes {} ({} ms), guest faults {}, "
+        "traps {}",
+        seconds, milliseconds[at(Counter::Idle)], count[at(Counter::Submit)],
+        milliseconds[at(Counter::Submit)], count[at(Counter::Flush)],
+        milliseconds[at(Counter::Flush)], count[at(Counter::Composite)],
+        milliseconds[at(Counter::Composite)], milliseconds[at(Counter::Swap)],
+        count[at(Counter::CompositeWait)], milliseconds[at(Counter::CompositeWait)],
+        count[at(Counter::CpuRead)], milliseconds[at(Counter::CpuRead)],
+        count[at(Counter::FenceWait)], milliseconds[at(Counter::FenceWait)],
+        count[at(Counter::NceGpuRead)], milliseconds[at(Counter::NceGpuRead)],
+        count[at(Counter::NceGpuWrite)], milliseconds[at(Counter::NceGpuWrite)],
+        count[at(Counter::NceGuestFault)], count[at(Counter::NceTrap)]);
+}
+
+}
