+std::optional<StorageBufferAddr> TrackDirectWords(const IR::Value& low_value, const IR::Value& high_value) {
+    if (low_value.IsImmediate() || high_value.IsImmediate()) {
+        return std::nullopt;
+    }
+    const IR::Inst* const low = low_value.InstRecursive();
+    const IR::Inst* const high = high_value.InstRecursive();
+    if (low->GetOpcode() != IR::Opcode::GetCbufU32 || high->GetOpcode() != IR::Opcode::GetCbufU32) {
+        return std::nullopt;
+    }
+    if (!low->Arg(0).IsImmediate() || !low->Arg(1).IsImmediate() ||
+        !high->Arg(0).IsImmediate() || !high->Arg(1).IsImmediate()) {
+        return std::nullopt;
+    }
+    const u32 index = low->Arg(0).U32();
+    const u32 offset = low->Arg(1).U32();
+    if (index != high->Arg(0).U32() || !Common::IsAligned(offset, 8U) ||
+        offset > (std::numeric_limits<u32>::max)() - 4 || high->Arg(1).U32() != offset + 4) {
+        return std::nullopt;
+    }
+    return StorageBufferAddr{.index = index, .offset = offset};
+}
+
+bool IsCarryOf(const IR::Value& value, const IR::Inst* addition) {
+    if (value.IsImmediate()) {
+        return false;
+    }
+    const IR::Inst* const select = value.InstRecursive();
+    if (select->GetOpcode() != IR::Opcode::SelectU32 || select->Arg(0).IsImmediate() ||
+        !select->Arg(1).IsImmediate() || !select->Arg(2).IsImmediate() ||
+        select->Arg(1).U32() != 1 || select->Arg(2).U32() != 0) {
+        return false;
+    }
+    const IR::Inst* const carry = select->Arg(0).InstRecursive();
+    return carry->GetOpcode() == IR::Opcode::GetCarryFromOp && !carry->Arg(0).IsImmediate() &&
+           carry->Arg(0).InstRecursive() == addition;
+}
+
+std::optional<StorageBufferAddr> TrackDirect(const LowAddrInfo& address) {
+    if (const auto direct = TrackDirectWords(address.value, address.high)) {
+        return direct;
+    }
+    if (address.value.IsImmediate() || address.high.IsImmediate()) {
+        return std::nullopt;
+    }
+    const IR::Inst* const low = address.value.InstRecursive();
+    const IR::Inst* const high = address.high.InstRecursive();
+    if (low->GetOpcode() != IR::Opcode::IAdd32 || high->GetOpcode() != IR::Opcode::IAdd32) {
+        return std::nullopt;
+    }
+    for (size_t high_word = 0; high_word < 2; ++high_word) {
+        if (!IsCarryOf(high->Arg(1 - high_word), low)) {
+            continue;
+        }
+        for (size_t low_word = 0; low_word < 2; ++low_word) {
+            if (const auto direct = TrackDirectWords(low->Arg(low_word), high->Arg(high_word))) {
+                return direct;
+            }
+        }
+    }
+    return std::nullopt;
+}
