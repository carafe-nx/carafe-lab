+std::optional<std::vector<const IR::Inst*>> PointerWordsInSum(const IR::Value& value) {
+    std::vector<IR::Value> pending{value};
+    std::vector<const IR::Inst*> words;
+    size_t remaining_nodes = 128;
+    while (!pending.empty()) {
+        if (remaining_nodes-- == 0) {
+            return std::nullopt;
+        }
+        const IR::Value current = pending.back();
