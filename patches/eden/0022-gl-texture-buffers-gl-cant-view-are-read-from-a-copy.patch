 }
 
+GLuint BufferCacheRuntime::CopiedView(Buffer& buffer, u32 offset, u32 size, PixelFormat format) {
+    static constexpr std::string_view BGRA_SWIZZLE_COMP = R"(#version 430
+layout(local_size_x = 64) in;
+layout(binding = 0, rgba8) uniform restrict imageBuffer texels;
+layout(location = 0) uniform int count;
+layout(location = 1) uniform int first;
+void main() {
+    const int texel = first + int(gl_GlobalInvocationID.x);
+    if (texel < count) {
+        imageStore(texels, texel, imageLoad(texels, texel).bgra);
+    }
+}
+)";
+    static constexpr u32 MAX_GROUPS = 65535;
+    TextureBufferCopy& copy = texture_buffer_copies[next_texture_buffer_copy++ %
+                                                    texture_buffer_copies.size()];
+    if (copy.size < size) {
+        copy.buffer.Release();
+        copy.buffer.Create();
+        copy.size = Common::NextPow2(size);
+        glNamedBufferData(copy.buffer.handle, copy.size, nullptr, GL_STREAM_COPY);
+    }
+    if (copy.view.handle == 0) {
+        copy.view.Create(GL_TEXTURE_BUFFER);
+    }
+    // The last shader that wrote this copy must be done before it is overwritten.
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    glCopyNamedBufferSubData(buffer.Handle(), copy.buffer.handle, offset, 0, size);
+    if (format != PixelFormat::B8G8R8A8_UNORM) {
+        const GLenum gl_format{MaxwellToGL::GetFormatTuple(format).internal_format};
+        glTextureBufferRange(copy.view.handle, GetTextureBufferFormat(gl_format),
+                             copy.buffer.handle, 0, size);
+        return copy.view.handle;
+    }
+    // Buffer textures have no swizzle: swap red and blue in the copy.
+    glTextureBufferRange(copy.view.handle, GL_RGBA8, copy.buffer.handle, 0, size);
+    if (bgra_swizzle_program.handle == 0) {
+        bgra_swizzle_program = CreateProgram(BGRA_SWIZZLE_COMP, GL_COMPUTE_SHADER);
+    }
+    const GLint count = static_cast<GLint>(size / 4);
+    GLint program = 0;
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    glUseProgram(bgra_swizzle_program.handle);
+    glBindImageTexture(0, copy.view.handle, 0, GL_FALSE, 0, GL_READ_WRITE, GL_RGBA8);
+    glUniform1i(0, count);
+    for (GLint first = 0; first < count; first += MAX_GROUPS * 64) {
+        glUniform1i(1, first);
+        const GLint left = count - first;
+        glDispatchCompute(std::min<u32>(MAX_GROUPS, static_cast<u32>((left + 63) / 64)), 1, 1);
+    }
+    glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT);
+    glUseProgram(static_cast<GLuint>(program));
+    return copy.view.handle;
+}
+
 void BufferCacheRuntime::BindImageBuffer(Buffer& buffer, u32 offset, u32 size, PixelFormat format) {
     *image_handles++ = buffer.View(offset, size, format);
 }
