@@ -371,9 +376,69 @@ void BufferCacheRuntime::BindTransformFeedbackBuffers(VideoCommon::HostBindings<
 
 void BufferCacheRuntime::BindTextureBuffer(Buffer& buffer, u32 offset, u32 size,
                                            PixelFormat format) {
+    const bool is_bgra = format == PixelFormat::B8G8R8A8_UNORM;
+    if (!use_assembly_shaders && (is_bgra || offset % texture_buffer_alignment != 0)) {
+        *texture_handles++ = CopiedView(buffer, offset, size, format);
+        return;
