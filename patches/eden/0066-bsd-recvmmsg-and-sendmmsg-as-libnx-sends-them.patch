+void BSD::RecvMMsgWork::Execute(BSD* bsd) {
+    const auto entries = ParseMMsg(buffer, vlen);
+    if (!entries) {
+        ret = -1;
+        bsd_errno = Errno::INVAL;
+        return;
+    }
+    reply.assign(1, MMSG_VERSION);
+    s32 received = 0;
+    bool drained = false;
+    for (const MMsgEntry& entry : *entries) {
+        if (drained) {
+            AppendEmptyEntry(reply, entry);
+            continue;
+        }
+        std::size_t total = 0;
+        for (const MMsgIov& iov : entry.iovs) {
+            total += iov.size;
+        }
+        std::vector<u8> message(total);
+        std::vector<u8> addr((std::max)(static_cast<std::size_t>(entry.name_len), SOCKADDR_IN_SIZE));
+        const u32 message_flags = received == 0 ? flags : (flags | Network::FLAG_MSG_DONTWAIT);
+        const auto [got, error] = bsd->RecvFromImpl(fd, message_flags, message, addr);
+        if (got < 0) {
+            if (received == 0) {
+                ret = -1;
+                bsd_errno = error;
+                return;
+            }
+            drained = true;
+            AppendEmptyEntry(reply, entry);
+            continue;
+        }
+        const u32 name_len =
+            static_cast<u32>((std::min)(addr.size(), (std::min)(static_cast<std::size_t>(entry.name_len),
+                                                                SOCKADDR_IN_SIZE)));
+        Append32(reply, name_len);
+        reply.insert(reply.end(), addr.begin(), addr.begin() + name_len);
+        Append32(reply, static_cast<u32>(entry.iovs.size()));
+        std::size_t from = 0;
+        for (const MMsgIov& iov : entry.iovs) {
+            const std::size_t part = (std::min)(iov.size, static_cast<std::size_t>(got) - from);
+            Append64(reply, part);
+            reply.insert(reply.end(), message.begin() + from, message.begin() + from + part);
+            from += part;
+        }
+        Append32(reply, 0);
+        Append32(reply, 0);
+        Append32(reply, static_cast<u32>(got));
+        ++received;
+    }
+    ret = received;
+    bsd_errno = Errno::SUCCESS;
+}
+
+void BSD::RecvMMsgWork::Response(HLERequestContext& ctx) {
+    if (ret >= 0) {
+        ctx.WriteBuffer(reply);
+    }
+
+    IPC::ResponseBuilder rb{ctx, 4};
+    rb.Push(ResultSuccess);
+    rb.Push<s32>(ret);
+    rb.PushEnum(bsd_errno);
+}
+
+void BSD::SendMMsgWork::Execute(BSD* bsd) {
+    const auto entries = ParseMMsg(buffer, vlen);
+    if (!entries) {
+        ret = -1;
+        bsd_errno = Errno::INVAL;
+        return;
+    }
+    s32 sent = 0;
+    for (const MMsgEntry& entry : *entries) {
+        std::vector<u8> message;
+        for (const MMsgIov& iov : entry.iovs) {
+            message.insert(message.end(), buffer.begin() + iov.offset,
+                           buffer.begin() + iov.offset + iov.size);
+        }
+        std::span<const u8> addr;
+        if (entry.name_len >= SOCKADDR_IN_SIZE) {
+            addr = std::span<const u8>(buffer).subspan(entry.name_offset, entry.name_len);
+        }
+        const auto [put, error] = bsd->SendToImpl(fd, flags, message, addr);
+        if (put < 0) {
+            if (sent == 0) {
+                ret = -1;
+                bsd_errno = error;
+                return;
+            }
+            break;
+        }
+        const u32 length = static_cast<u32>(put);
+        std::memcpy(buffer.data() + entry.length_offset, &length, sizeof(length));
+        ++sent;
+    }
+    ret = sent;
+    bsd_errno = Errno::SUCCESS;
+}
+
+void BSD::SendMMsgWork::Response(HLERequestContext& ctx) {
+    if (ret >= 0) {
+        ctx.WriteBuffer(buffer);
+    }
+
+    IPC::ResponseBuilder rb{ctx, 4};
+    rb.Push(ResultSuccess);
+    rb.Push<s32>(ret);
+    rb.PushEnum(bsd_errno);
+}
