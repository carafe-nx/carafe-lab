+void BSD::RecvMMsg(HLERequestContext& ctx) {
+    IPC::RequestParser rp{ctx};
+    const s32 fd = rp.Pop<s32>();
+    const u32 vlen = rp.Pop<u32>();
+    const u32 flags = rp.Pop<u32>();
+
+    std::vector<u8> buffer;
+    if (!ctx.BufferDescriptorB().empty()) {
+        const auto& descriptor = ctx.BufferDescriptorB()[0];
+        buffer.resize(descriptor.Size());
+        ctx.GetMemory().ReadBlock(descriptor.Address(), buffer.data(), buffer.size());
+    }
+
+    LOG_DEBUG(Service, "called. fd={} vlen={} flags=0x{:x} len={}", fd, vlen, flags, buffer.size());
+
+    ExecuteWork(ctx, RecvMMsgWork{
+                         .fd = fd,
+                         .vlen = vlen,
+                         .flags = flags,
+                         .buffer = std::move(buffer),
+                     });
+}
+
