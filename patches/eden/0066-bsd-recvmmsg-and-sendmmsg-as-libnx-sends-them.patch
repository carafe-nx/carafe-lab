+constexpr u8 MMSG_VERSION = 8;
+constexpr std::size_t SOCKADDR_IN_SIZE = 16;
+
+struct MMsgIov {
+    std::size_t offset;
+    std::size_t size;
+};
+
+struct MMsgEntry {
+    std::size_t name_offset;
+    u32 name_len;
+    std::vector<MMsgIov> iovs;
+    std::size_t length_offset;
+};
+
+class MMsgReader {
+public:
+    explicit MMsgReader(std::span<const u8> buffer_) : buffer{buffer_} {}
+
+    bool Read32(u32& value) {
+        if (buffer.size() - at < sizeof(value)) {
+            return false;
+        }
+        std::memcpy(&value, buffer.data() + at, sizeof(value));
+        at += sizeof(value);
+        return true;
+    }
+
+    bool Read64(u64& value) {
+        if (buffer.size() - at < sizeof(value)) {
+            return false;
+        }
+        std::memcpy(&value, buffer.data() + at, sizeof(value));
+        at += sizeof(value);
+        return true;
+    }
+
+    bool Skip(u64 size, std::size_t& offset) {
+        if (buffer.size() - at < size) {
+            return false;
+        }
+        offset = at;
+        at += static_cast<std::size_t>(size);
+        return true;
+    }
+
+    std::size_t At() const {
+        return at;
+    }
+
+private:
+    std::span<const u8> buffer;
+    std::size_t at{1};
+};
+
+std::optional<std::vector<MMsgEntry>> ParseMMsg(std::span<const u8> buffer, u32 vlen) {
+    if (buffer.empty()) {
+        return std::nullopt;
+    }
+    MMsgReader reader{buffer};
+    std::vector<MMsgEntry> entries;
+    for (u32 i = 0; i < vlen; ++i) {
+        MMsgEntry entry{};
+        u32 iov_count{};
+        u32 control_len{};
+        u32 flags{};
+        u32 length{};
+        std::size_t control_offset{};
+        if (!reader.Read32(entry.name_len) || !reader.Skip(entry.name_len, entry.name_offset) ||
+            !reader.Read32(iov_count)) {
+            return std::nullopt;
+        }
+        for (u32 j = 0; j < iov_count; ++j) {
+            u64 size{};
+            MMsgIov iov{};
+            if (!reader.Read64(size) || !reader.Skip(size, iov.offset)) {
+                return std::nullopt;
+            }
+            iov.size = static_cast<std::size_t>(size);
+            entry.iovs.push_back(iov);
+        }
+        if (!reader.Read32(control_len) || !reader.Skip(control_len, control_offset) ||
+            !reader.Read32(flags)) {
+            return std::nullopt;
+        }
+        entry.length_offset = reader.At();
+        if (!reader.Read32(length)) {
+            return std::nullopt;
+        }
+        entries.push_back(std::move(entry));
+    }
+    return entries;
+}
+
+void Append32(std::vector<u8>& out, u32 value) {
+    const auto* bytes = reinterpret_cast<const u8*>(&value);
+    out.insert(out.end(), bytes, bytes + sizeof(value));
+}
+
+void Append64(std::vector<u8>& out, u64 value) {
+    const auto* bytes = reinterpret_cast<const u8*>(&value);
+    out.insert(out.end(), bytes, bytes + sizeof(value));
+}
+
+void AppendEmptyEntry(std::vector<u8>& out, const MMsgEntry& entry) {
+    Append32(out, 0);
+    Append32(out, static_cast<u32>(entry.iovs.size()));
+    for (std::size_t i = 0; i < entry.iovs.size(); ++i) {
+        Append64(out, 0);
+    }
+    Append32(out, 0);
+    Append32(out, 0);
+    Append32(out, 0);
+}
+
