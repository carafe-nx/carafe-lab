+bool IsGlobalPointerLoad(IR::Opcode opcode) {
+    return opcode == IR::Opcode::LoadGlobal64 || opcode == IR::Opcode::LoadGlobal128;
+}
+
+struct IndirectInfo {
+    StorageBufferAddr storage_buffer;
+    IR::Value pointer_low;
+};
+
+const IR::Inst* PointerWord(const IR::Value& value) {
+    if (value.IsImmediate()) {
+        return nullptr;
+    }
+    const IR::Inst* const inst{value.InstRecursive()};
+    const IR::Opcode opcode{inst->GetOpcode()};
+    if (opcode != IR::Opcode::CompositeExtractU32x2 && opcode != IR::Opcode::CompositeExtractU32x4) {
+        return nullptr;
+    }
+    if (inst->Arg(0).IsImmediate() || !inst->Arg(1).IsImmediate()) {
+        return nullptr;
+    }
+    if (!IsGlobalPointerLoad(inst->Arg(0).InstRecursive()->GetOpcode())) {
+        return nullptr;
+    }
+    return inst;
+}
+
+std::optional<IndirectInfo> TrackIndirect(IR::Inst& inst) {
+    const std::optional<LowAddrInfo> low_addr{TrackLowAddress(&inst)};
+    if (!low_addr) {
+        return std::nullopt;
+    }
+    const IR::Inst* low_word{PointerWord(low_addr->value)};
+    if (!low_word && !low_addr->value.IsImmediate()) {
+        const IR::Inst* const add{low_addr->value.InstRecursive()};
+        if (add->GetOpcode() == IR::Opcode::IAdd32) {
+            low_word = PointerWord(add->Arg(0));
+            if (!low_word) {
+                low_word = PointerWord(add->Arg(1));
+            }
+        }
+    }
+    const IR::Inst* const high_word{PointerWord(low_addr->high)};
+    if (!low_word || !high_word) {
+        return std::nullopt;
+    }
+    const u32 element{low_word->Arg(1).U32()};
+    if (low_word->Arg(0).InstRecursive() != high_word->Arg(0).InstRecursive() ||
+        high_word->Arg(1).U32() != element + 1 || (element % 2) != 0) {
+        return std::nullopt;
+    }
+    IR::Inst* const load{low_word->Arg(0).InstRecursive()};
+    const std::optional<LowAddrInfo> load_addr{TrackLowAddress(load)};
+    if (!load_addr) {
+        return std::nullopt;
+    }
+    const std::optional<StorageBufferAddr> base{Track(load_addr->value, nullptr)};
+    if (!base) {
+        return std::nullopt;
+    }
+    const s32 descriptor_offset{load_addr->imm_offset + static_cast<s32>(element * 4)};
+    if (descriptor_offset < 0) {
+        return std::nullopt;
+    }
+    return IndirectInfo{
+        .storage_buffer{
+            .index = base->index,
+            .offset = base->offset,
+            .indirect = true,
+            .indirect_offset = static_cast<u32>(descriptor_offset),
+        },
+        .pointer_low = IR::Value{const_cast<IR::Inst*>(low_word)},
+    };
+}
+
 /// Collects the storage buffer used by a global memory instruction and the instruction itself
