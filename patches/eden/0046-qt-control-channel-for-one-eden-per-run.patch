+void MainWindow::ControlReply(const QString& text) {
+    QFile file(control_dir + QStringLiteral("/replies"));
+    if (file.open(QIODevice::Append | QIODevice::Text)) {
+        file.write(QStringLiteral("%1 %2\n").arg(++control_sequence).arg(text).toUtf8());
+    }
+    LOG_INFO(Frontend, "Control: {}", text.toStdString());
+}
+
+void MainWindow::OnControlTick() {
+    const QString path = control_dir + QStringLiteral("/command");
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return;
+    }
+    const QString line = QString::fromUtf8(file.readAll()).trimmed();
+    file.close();
+    QFile::remove(path);
+    const qsizetype space = line.indexOf(QLatin1Char(' '));
+    const QString verb = space < 0 ? line : line.left(space);
+    const QString argument = space < 0 ? QString{} : line.mid(space + 1).trimmed();
+    if (verb == QStringLiteral("boot")) {
+        if (emulation_running) {
+            ControlReply(QStringLiteral("error busy"));
+            return;
+        }
+        quit_after_stop = false;
+        ControlReply(QStringLiteral("booting %1").arg(argument));
+        BootGame(argument, ApplicationAppletParameters());
+        ControlReply(emulation_running ? QStringLiteral("booted") : QStringLiteral("error boot"));
+    } else if (verb == QStringLiteral("stop") || verb == QStringLiteral("quit")) {
+        quit_after_stop = verb == QStringLiteral("quit");
+        if (!emulation_running) {
+            ControlReply(QStringLiteral("stopped idle"));
+            if (quit_after_stop) {
+                close();
+            }
+            return;
+        }
+        control_stop_pending = true;
+        play_time_manager->Stop();
+        control_waited = OnShutdownBegin();
+        if (control_waited) {
+            OnShutdownBeginDialog();
+        } else {
+            OnEmulationStopped();
+        }
+    } else if (verb == QStringLiteral("screenshot")) {
+        if (!emulation_running || render_window == nullptr) {
+            ControlReply(QStringLiteral("error idle"));
+            return;
+        }
+        render_window->CaptureScreenshot(argument);
+        ControlReply(QStringLiteral("capturing %1").arg(argument));
+    } else {
+        ControlReply(QStringLiteral("error unknown %1").arg(verb));
+    }
+}
 #endif // __unix__
 
