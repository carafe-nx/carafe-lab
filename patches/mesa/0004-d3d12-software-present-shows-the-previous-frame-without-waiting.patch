+bool
+d3d12_resource_copy_for_present(struct pipe_context *pctx, struct pipe_resource *pres,
+                                unsigned level, unsigned layer,
+                                struct pipe_resource **buffer, unsigned *stride)
+{
+   struct d3d12_context *ctx = d3d12_context(pctx);
+   struct d3d12_transfer trans = {};
+   struct pipe_transfer *ptrans = &trans.base.b;
+
+   ptrans->level = level;
+   ptrans->usage = PIPE_MAP_READ;
+   u_box_2d_zslice(0, 0, layer, u_minify(pres->width0, level), u_minify(pres->height0, level),
+                   &ptrans->box);
+   ptrans->stride = align(util_format_get_stride(pres->format, ptrans->box.width),
+                          D3D12_TEXTURE_DATA_PITCH_ALIGNMENT);
+   ptrans->layer_stride = align(static_cast<uint32_t>(util_format_get_2d_size(pres->format,
+                                                                             ptrans->stride,
+                                                                             ptrans->box.height)),
+                                D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT);
+
+   if (!*buffer) {
+      *buffer = pipe_buffer_create(pctx->screen, 0, PIPE_USAGE_STAGING,
+                                   static_cast<unsigned>(ptrans->layer_stride));
+      if (!*buffer)
+         return false;
+   }
+
+   *stride = ptrans->stride;
+   return transfer_image_to_buf(ctx, d3d12_resource(pres), d3d12_resource(*buffer), &trans, 0);
+}
+
 static void
 transfer_buf_to_buf(struct d3d12_context *ctx,
                     struct d3d12_resource *src,
