{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Carafe Lab",
  "identifier": "app.carafe.lab",
  "build": {
    "devUrl": "http://localhost:1430",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "npm run dev --workspace ui",
    "beforeBuildCommand": "npm run build --workspace ui"
  },
  "app": {
    "windows": [
      {
        "title": "Carafe Lab",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src http://127.0.0.1:6080"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../external/carafe/assets/logo/icon.ico"]
  }
}
